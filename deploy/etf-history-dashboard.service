[Unit]
Description=etf-history: Streamlit dashboard
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h/code/etf-history
ExecStart=%h/.local/bin/uv run --frozen --no-dev --extra dashboard etf-history dashboard --port 8501
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
