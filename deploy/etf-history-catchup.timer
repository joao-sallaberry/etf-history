[Unit]
Description=etf-history: evening holdings download

[Timer]
# Dimensional publishes a day's file one or two days later; two runs a day (this one and
# etf-history-morning.timer at 09:00) keep the lag short. Avantis only serves the latest day, so a day with no run
# is lost for AVES.
OnCalendar=*-*-* 21:00:00 America/Sao_Paulo
Persistent=true

[Install]
WantedBy=timers.target
